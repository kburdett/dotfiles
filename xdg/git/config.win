[core]
	autocrlf = true

[diff]
    tool = winmerge
[difftool "winmerge"]
    cmd = "WinMergeU" -u -e \"$LOCAL\" \"$REMOTE\"
    trustExitCode = true
[difftool]
    prompt = false

[merge]
    tool = winmerge
[mergetool "winmerge"]
    cmd = "WinMergeU" -u -e -fm -wl -dl \"Local\" -wr -dr \"Remote\" \"$LOCAL\" \"$BASE\" \"$REMOTE\" -o \"$MERGED\"
    trustExitCode = true
    keepBackup = false
[mergetool]
    prompt = false

[credential "https://github.com"]
	helper = !'C:\\Program Files\\GitHub CLI\\gh.exe' auth git-credential
[credential "https://gist.github.com"]
	helper = !'C:\\Program Files\\GitHub CLI\\gh.exe' auth git-credential

