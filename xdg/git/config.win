[core]
	autocrlf = true

[diff]
    tool = winmerge
[difftool "winmerge"]
    cmd = "WinMergeU" -u -e \"$LOCAL\" \"$REMOTE\"
    trustExitCode = true
[difftool]
    prompt = false

[merge]
    tool = winmerge
[mergetool "winmerge"]
    cmd = "WinMergeU" -u -e -fm -wl -dl \"Local\" -wr -dr \"Remote\" \"$LOCAL\" \"$BASE\" \"$REMOTE\" -o \"$MERGED\"
    trustExitCode = true
    keepBackup = false
[mergetool]
    prompt = false
