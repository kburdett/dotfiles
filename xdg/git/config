# Shared Git settings. OS-specific settings come from config.<os> (picked by the bootstrap
# script through config.os), and per-machine settings such as [user] from config.local.
# Global ignores live in ./ignore, Git's default location for them.

[init]
    defaultBranch = main

[core]
    untrackedCache = true

[column]
    ui = auto
[branch]
    sort = -committerdate
[tag]
    sort = version:refname

[diff]
    algorithm = histogram
    colorMoved = plain
    mnemonicPrefix = true
    renames = true
    renameLimit = 5000

[commit]
    verbose = true
[help]
    autocorrect = prompt

[fetch]
    prune = true
[pull]
    ff = only           # plain `git pull` never merges; use `git pr` / `git pull -r` to rebase
[push]
    autoSetupRemote = true
    followTags = true

[merge]
    conflictStyle = zdiff3
[rebase]
    autoSquash = true
    autoStash = true
    updateRefs = true
[rerere]
    enabled = true
    autoUpdate = true

[filter "lfs"]
    process = git-lfs filter-process
    required = true
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f

[credential "https://git.kevinburdett.com"]
    provider = generic

[alias]
    cp = cherry-pick
    sq = show --quiet
    rp = repack -a -d --depth=500 --window=1000 -f
    mnff = merge --no-ff
    ss = status -sb

    aa = add .
    unstage = restore --staged

    dt = difftool
    dtc = difftool --cached
    mt = mergetool

    co = checkout
    cob = checkout -b
    cod = checkout develop
    com = checkout main
    cos = checkout stable
    sw = switch
    swc = switch -c

    cm = commit
    cmm = commit -m
    cma = commit --amend
    cmane = commit --amend --no-edit

    br = branch
    brl = branch -vv
    brr = branch -rvv
    bra = branch -avv
    brd = branch -dvv
    brD = branch -Dvv

    lola = log --graph --decorate --pretty=oneline --abbrev-commit --all
    lol = log --graph --decorate --pretty=oneline --abbrev-commit
    lrc = log -5 --decorate

    po = push origin
    pu = push upstream
    puo = push -u origin
    pfl = push --force-with-lease --force-if-includes
    pom = push origin main
    pod = push origin develop
    pos = push origin stable
    pum = push upstream main
    pud = push upstream develop
    pus = push upstream stable

    fp = fetch -p
    fpo = fetch -p origin
    fpu = fetch -p upstream

    pff = pull --ff-only --no-rebase
    pffom = pull --ff-only --no-rebase origin main
    pffod = pull --ff-only --no-rebase origin develop
    pffos = pull --ff-only --no-rebase origin stable
    pffum = pull --ff-only --no-rebase upstream main
    pffud = pull --ff-only --no-rebase upstream develop
    pffus = pull --ff-only --no-rebase upstream stable

    pr = pull -r
    prom = pull -r origin main
    prod = pull -r origin develop
    pros = pull -r origin stable
    prum = pull -r upstream main
    prud = pull -r upstream develop
    prus = pull -r upstream stable

    ri = rebase -i
    rom = rebase origin/main
    rod = rebase origin/develop
    ros = rebase origin/stable
    rum = rebase upstream/main
    rud = rebase upstream/develop
    rus = rebase upstream/stable

# Relative paths resolve next to this file. Later files win, so local overrides everything.
[include]
    path = config.os
    path = config.local
