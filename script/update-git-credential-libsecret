#!/usr/bin/env bash
# Build Git's libsecret credential helper into ~/.local/bin (native Debian; WSL uses GCM instead).
# Debian's git package ships the helper's source but no binary.
# Needs a C compiler, pkg-config and libsecret-1-dev (bootstrap.sh --packages installs them).
set -euo pipefail

src=/usr/share/doc/git/contrib/credential/libsecret/git-credential-libsecret.c
dest=$HOME/.local/bin/git-credential-libsecret

if [[ ! -f $src ]]; then
    echo "Not found: $src (is git installed from apt?)" >&2
    exit 1
fi

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
# shellcheck disable=SC2046  # pkg-config's flags must be split into words
cc -O2 -Wall -o "$tmp" "$src" $(pkg-config --cflags --libs libsecret-1 glib-2.0)

mkdir -p "${dest%/*}"
install -m 755 "$tmp" "$dest"
echo "  built   $dest"
